{% extends 'base.html.twig' %}

{% block title %}BookShelf{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/scripts/codeReaderCaller.js"></script>
    <script src="/assets/scripts/index.js"></script>
{% endblock %}

{% block body %}
    <h1>BookShelf</h1>
    <hr />

    <section>
        <h2>Search</h2>

        <form method="get" action="{{ path('book_index') }}">
            <label for="search-book">Search Book by Name:</label>
            <input type="text" name="q" id="search-book" placeholder="Search by title or ISBN" />
            <button type="submit">Search</button>
        </form>

        <form method="get" action="{{ path('book_index') }}" id="search-book-isbn-form">
            <label for="search-book-isbn">Search Book by ISBN:</label>
            <input type="text" name="isbn" id="search-book-isbn" placeholder="Search by ISBN" />
            <button type="submit">Search</button>
            <button onclick="callCodeReaderForBookSearchScreen()" type="button">Scan Barcode</button>
        </form>

        <form method="get" action="{{ path('home_code_jump') }}" id="jump-to-code-form">
            <label for="jump-to-code">Jump to Code:</label>
            <input type="text" name="code" id="jump-to-code" placeholder="Jump to BookShelf code" />
            <button type="submit">Search</button>
            <button onclick="callCodeReaderForCodeJumpScreen()" type="button">Scan Barcode</button>
        </form>
    </section>

    <section>
        <h2>Sites</h2>
        {% set visibleSites = sites|filter(s => not s.isHidden(app.user)) %}
        <ul>
            {% for site in visibleSites %}
                <li>
                    <a href="{{ path('site_show', {'id': site.id}) }}">
                        {{ site.name }}
                    </a>
                </li>
            {% endfor %}
            {% if sites|length - visibleSites|length > 0 %}
                <li class="private-hidden">{{ sites|length - visibleSites|length }} private site(s) hidden.</li>
            {% endif %}
        </ul>
        {{ visibleSites|length }} site(s) found.
        {% if sites|length - visibleSites|length > 0 %}{{ sites|length - visibleSites|length }} private site(s) hidden.{% endif %}
    </section>

    <section>
        <h2>Recently Added Books</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                </tr>
            </thead>
            {% set visibleRecentBooks = recentBooks|filter(b => not b.isHidden(app.user)) %}
            <tbody>
                {% for book in visibleRecentBooks %}
                    <tr>
                        <td>{{ book.id }}</td>
                        <td>
                            <a href="{{ path('book_show', {'id': book.id}) }}">
                                {{ book.name }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                {% if recentBooks|length - visibleRecentBooks|length > 0 %}
                    <tr class="private-hidden">
                        <td colspan="2">Some books are private and hidden from anonymous visitors.</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        {{ visibleRecentBooks|length }} book(s) found.
        {% if recentBooks|length - visibleRecentBooks|length > 0 %}{{ recentBooks|length - visibleRecentBooks|length }} private book(s) hidden.{% endif %}
    </section>

{% endblock %}

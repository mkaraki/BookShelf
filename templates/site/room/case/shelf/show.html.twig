{% extends 'base.html.twig' %}

{% block title %}Shelf: {{ shelf.shelfNumber | escape }}{% endblock %}

{% block body %}
    <h1>Shelf: {{ shelf.shelfNumber | escape }}</h1>
    <a href="{{ path('site_show', {'id': site.id}) }}">Back to Site</a><br />
    <a href="{{ path('room_show', {'site_id': site.id, 'room_id': room.id}) }}">Back to Room</a><br />
    <a href="{{ path('book_case_show', {'site_id': site.id, 'room_id': room.id, 'case_id': case.id}) }}">Back to Case</a><br />
    <hr />

    <dl>
        <dt>Code</dt>
        <dd>{{ shelf.code | escape }}</dd>

        <dt>ID</dt>
        <dd>{{ shelf.id | escape }}</dd>

        <dt>Shelf No.</dt>
        <dd>{{ shelf.shelfNumber | escape }}</dd>

        <dt>Site</dt>
        <dd>{{ site.name | escape }}</dd>

        <dt>Room</dt>
        <dd>{{ room.name | escape }}</dd>

        <dt>Case</dt>
        <dd>{{ case.name | escape }}</dd>
    </dl>

    <h2>Shelves</h2>
    <a href="{{ path('ob_new', {'shelf_id': shelf.id}) }}">Add New Book</a>
    <table class="table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Book ID</th>
                <th>Book Title</th>
                <th>ISBN</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% set visibleObs = shelf.ownedBooks|filter(ob => not ob.isHidden(app.user)) %}
        {% set hiddenObs = shelf.ownedBooks|length - visibleObs|length %}
        {% for ob in visibleObs %}
            <tr>
                <td>{{ ob.code | escape }}</td>
                <td>{{ ob.book.id }}</td>
                <td>
                    <a href="{{ path('book_show', {'id': ob.book.id}) }}">
                        {{ ob.book.name | escape }}
                    </a>
                    {% if ob.book.disambiguation %}({{ ob.book.disambiguation | escape }}){% endif %}
                    <br />
                    <small>{{ ob.book.bookRead | escape }}</small>
                </td>
                <td>
                    {{ ob.book.isbn | escape }}
                </td>
                <td>
                    <form action="{{ path('ob_edit', { 'id': ob.id }) }}"
                          method="get" style="display:inline;">
                        <button>Edit</button>
                    </form>
                    <form action="{{ path('ob_delete', { 'id': ob.id }) }}"
                          method="post" onsubmit="return confirm('Are you sure you want to delete this book?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ob.id) }}">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        {% if hiddenObs > 0 %}
            <tr class="private-hidden">
                <td colspan="5">Some books are private and hidden from anonymous visitors.</td>
            </tr>
        {% endif %}
        </tbody>
    </table>
    {{ visibleObs | length }} book(s) found.
    {% if hiddenObs > 0 %}{{ hiddenObs }} private book(s) hidden.{% endif %}
{% endblock %}

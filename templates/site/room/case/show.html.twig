{% extends 'base.html.twig' %}

{% block title %}Book Case: {{ case.name | escape }}{% endblock %}

{% block body %}
    <h1>Book Case: {{ case.name | escape }}</h1>
    <a href="{{ path('site_show', {'id': site.id}) }}" class="btn btn-secondary mb-3">Back to Site</a><br />
    <a href="{{ path('room_show', {'site_id': site.id, 'room_id': room.id}) }}" class="btn btn-secondary mb-3">Back to Room</a>
    <hr />

    <dl>
        <dt>Code</dt>
        <dd>{{ case.code | escape }}</dd>

        <dt>ID</dt>
        <dd>{{ case.id | escape }}</dd>

        <dt>Name</dt>
        <dd>{{ case.name | escape }}</dd>

        <dt>Site</dt>
        <dd>{{ site.name | escape }}</dd>

        <dt>Room</dt>
        <dd>{{ room.name | escape }}</dd>
    </dl>

    <h2>Shelves</h2>
    <a href="{{ path('shelf_new', {'site_id': site.id, 'room_id': room.id, 'case_id': case.id}) }}" class="btn btn-primary mb-3">Add New Shelf</a>
    <table class="table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Shelf No.</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% set visibleShelves = case.shelves|filter(s => not s.isHidden(app.user))|sort((a, b) => a.shelfNumber <=> b.shelfNumber) %}
        {% set hiddenShelves = case.shelves|length - visibleShelves|length %}
        {% for shelf in visibleShelves %}
            <tr>
                <td>{{ shelf.code | escape }}</td>
                <td>
                    <a href="{{ path('shelf_show', { 'site_id': site.id, 'room_id': room.id, 'case_id': case.id, 'shelf_id': shelf.id }) }}">
                        No. {{ shelf.shelfNumber | escape }}
                    </a>
                </td>
                <td>
                    <form action="{{ path('shelf_edit', { 'site_id': site.id, 'room_id': room.id, 'case_id': case.id, 'shelf_id': shelf.id }) }}"
                          method="get" style="display:inline;">
                        <button class="btn btn-sm btn-secondary">Edit</button>
                    </form>
                    <form action="{{ path('shelf_delete', { 'site_id': site.id, 'room_id': room.id, 'case_id': case.id, 'shelf_id': shelf.id }) }}"
                          method="post" onsubmit="return confirm('Are you sure you want to delete this shelf?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ shelf.id) }}">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
            <tr>
                <td colspan="3">
                    <table class="table">
                        <tbody>
                            {% set visibleOwnedBooks = shelf.ownedBooks|filter(ob => not ob.isHidden(app.user)) %}
                            {% set hiddenOwnedBooks = shelf.ownedBooks|length - visibleOwnedBooks|length %}
                            {% for ownedBook in visibleOwnedBooks %}
                                <tr>
                                    <td>{{ ownedBook.code | escape }}</td>
                                    <td>
                                        <a href="{{ path('book_show', { 'id': ownedBook.book.id }) }}">
                                            {{ ownedBook.book.name | escape }}
                                        </a>
                                        <small>
                                            (BID: {{ ownedBook.book.id | escape }}
                                            {% if ownedBook.book.isbn %}, ISBN: {{ ownedBook.book.isbn | escape }}{% endif %})
                                        </small>
                                    </td>
                                </tr>
                            {% endfor %}
                            {% if hiddenOwnedBooks > 0 %}
                                <tr>
                                    <td colspan="2">{{ hiddenOwnedBooks }} private book(s) hidden on this shelf.</td>
                                </tr>
                            {% elseif visibleOwnedBooks | length == 0 %}
                                <tr>
                                    <td colspan="2">No books found on this shelf.</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </td>
            </tr>
        {% endfor %}
        {% if hiddenShelves > 0 %}
            <tr class="private-hidden">
                <td colspan="3">Some shelves are private and hidden from anonymous visitors.</td>
            </tr>
        {% endif %}
        </tbody>
    </table>
    {{ visibleShelves | length }} shelf(s) found.
    {% if hiddenShelves > 0 %}{{ hiddenShelves }} private shelf(s) hidden.{% endif %}
{% endblock %}

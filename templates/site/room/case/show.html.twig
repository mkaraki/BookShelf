{% extends 'base.html.twig' %}

{% block title %}Book Case: {{ case.name | escape }}{% endblock %}

{% block body %}
    <h1>Book Case: {{ case.name | escape }}</h1>
    <a href="{{ path('site_show', {'id': site.id}) }}" class="btn btn-secondary mb-3">Back to Site</a><br />
    <a href="{{ path('room_show', {'site_id': site.id, 'room_id': room.id}) }}" class="btn btn-secondary mb-3">Back to Room</a>
    <hr />

    <dl>
        <dt>ID</dt>
        <dd>{{ case.id | escape }}</dd>

        <dt>Name</dt>
        <dd>{{ case.name | escape }}</dd>

        <dt>Site</dt>
        <dd>{{ site.name | escape }}</dd>

        <dt>Room</dt>
        <dd>{{ room.name | escape }}</dd>
    </dl>

    <h2>Shelves</h2>
    <a href="{{ path('shelf_new', {'site_id': site.id, 'room_id': room.id, 'case_id': case.id}) }}" class="btn btn-primary mb-3">Add New Shelf</a>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Shelf No.</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for shelf in case.shelves|sort((a, b) => a.shelfNumber <=> b.shelfNumber) %}
            <tr>
                <td>{{ shelf.id | escape }}</td>
                <td>
                    <a href="{{ path('shelf_show', { 'site_id': site.id, 'room_id': room.id, 'case_id': case.id, 'shelf_id': shelf.id }) }}">
                        {{ shelf.shelfNumber | escape }}
                    </a>
                </td>
                <td>
                    <form action="{{ path('shelf_edit', { 'site_id': site.id, 'room_id': room.id, 'case_id': case.id, 'shelf_id': shelf.id }) }}"
                          method="get" style="display:inline;">
                        <button class="btn btn-sm btn-secondary">Edit</button>
                    </form>
                    <form action="{{ path('shelf_delete', { 'site_id': site.id, 'room_id': room.id, 'case_id': case.id, 'shelf_id': shelf.id }) }}"
                          method="post" onsubmit="return confirm('Are you sure you want to delete this shelf?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ shelf.id) }}">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ case.shelves | length }} shelf(s) found.
{% endblock %}

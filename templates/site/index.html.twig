{% extends 'base.html.twig' %}

{% block title %}Sites{% endblock %}

{% block body %}
    <h1>Sites</h1>
    <a href="{{ path('site_new') }}" class="btn btn-primary mb-3">Create new</a>
    <hr />

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% set visibleSites = sites|filter(s => not s.isHidden(app.user)) %}
        {% set hiddenSites = sites|length - visibleSites|length %}
        {% for site in visibleSites %}
            <tr>
                <th scope="row">{{ site.id | escape }}</th>
                <td>
                    <a href="{{ path('site_show', {'id': site.id}) }}">
                        {{ site.name | escape }}
                    </a>
                </td>
                <td class="action-td">
                    <form action="{{ path('site_edit', {'id': site.id}) }}" method="get" style="display:inline;">
                        <button class="btn btn-sm btn-secondary">Edit</button>
                    </form>
                    <form action="{{ path('site_delete', {'id': site.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this site?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ site.id) }}">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        {% if hiddenSites > 0 %}
            <tr class="private-hidden">
                <td colspan="3">Some sites are private and hidden from anonymous visitors.</td>
            </tr>
        {% endif %}
        </tbody>
    </table>
    {{ visibleSites | length }} site(s) found.
    {% if hiddenSites > 0 %}{{ hiddenSites }} private site(s) hidden.{% endif %}
{% endblock %}

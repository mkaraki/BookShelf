{% extends 'base.html.twig' %}

{% block title %}Site: {{ site.name | escape }}{% endblock %}

{% block body %}
    <h1>Site: {{ site.name | escape }}</h1>
    <a href="{{ path('site_index') }}" class="btn btn-secondary mb-3">Back to List</a>
    <hr />

    <dl>
        <dt>ID</dt>
        <dd>{{ site.id | escape }}</dd>

        <dt>Name</dt>
        <dd>{{ site.name | escape }}</dd>
    </dl>

    <h2>Rooms</h2>
    <a href="{{ path('room_new', {'site_id': site.id}) }}" class="btn btn-primary mb-3">Add New Room</a>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Room name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for room in site.rooms %}
            <tr>
                <td>{{ room.id | escape }}</td>
                <td>
                    <a href="{{ path('room_show', {'site_id': site.id, 'room_id': room.id}) }}">
                        {{ room.name | escape }}
                    </a>
                </td>
                <td>
                    <form action="{{ path('room_edit', { 'site_id': site.id, 'room_id': room.id}) }}" method="get" style="display:inline;">
                        <button class="btn btn-sm btn-secondary">Edit</button>
                    </form>
                    <form action="{{ path('room_delete', {'site_id': site.id, 'room_id': room.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this room?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ room.id) }}">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ site.rooms | length }} room(s) found.
{% endblock %}

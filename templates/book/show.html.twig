{% extends 'base.html.twig' %}

{% block title %}Book: {{ book.name | escape }}{% endblock %}

{% block body %}
    <h1>Book: {{ book.name | escape }}</h1>
    <a href="{{ path('book_index') }}" class="btn btn-secondary mb-3">Back to List</a>
    <hr />

    <dl>
        <dt>ID</dt>
        <dd>{{ book.id | escape }}</dd>

        <dt>Name</dt>
        <dd>{{ book.name | escape }}</dd>

        <dt>ISBN</dt>
        <dd>{{ book.isbn | escape }}</dd>

        {% if book.disambiguation %}
            <dt>Disambiguation</dt>
            <dd>{{ book.disambiguation | escape }}</dd>
        {% endif %}

        {% if book.bookRead %}
            <dt>Book Read</dt>
            <dd>{{ book.bookRead | escape }}</dd>
        {% endif %}
    </dl>

    <h2>Available Stores</h2>
    <a href="{{ path('ob_new', {'book_id': book.id}) }}">Add to Library</a>
    <table class="table">
        <thead>
            <tr>
                <th>Book Code</th>
                <th>Shelf Code</th>
                <th>Shelf</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for ob in book.ownedBooks %}
            <tr>
                <td>{{ ob.code | escape }}</td>
                <td>{{ ob.parentShelf.code | escape }}</td>
                <td>
                    <a href="{{ path('shelf_show', {
                        'site_id': ob.parentShelf.parentBookCase.parentRoom.parentSite.id,
                        'room_id': ob.parentShelf.parentBookCase.parentRoom.id,
                        'case_id': ob.parentShelf.parentBookCase.id,
                        'shelf_id': ob.parentShelf.id
                    }) }}">
                        {{ ob.parentShelf.parentBookCase.parentRoom.parentSite.name | escape }}
                        /
                        {{ ob.parentShelf.parentBookCase.parentRoom.name | escape }}
                        /
                        {{ ob.parentShelf.parentBookCase.name | escape }}
                        /
                        {{ ob.parentShelf.shelfNumber | escape }}
                    </a>
                </td>
                <td class="action-td">
                    <form action="{{ path('ob_edit', {'id': ob.id}) }}" method="get" style="display:inline;">
                        <button class="btn btn-sm btn-secondary">Edit</button>
                    </form>
                    <form action="{{ path('ob_delete', {'id': ob.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this collected book?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ob.id) }}">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {{ book.ownedBooks | length }} book(s) found.
{% endblock %}

{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
        {
            "matchPackageNames": [
                "actions/*",
                "docker/*",
                "sigstore/*",
                "github/*"
            ],
            "matchDatasources": [
                "github-actions"
            ],
            "groupName": "Actions/Docker/SigStore actions",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchPackageNames": [
                "mkaraki/mkarakiapps-releasing-actions"
            ],
            "matchDatasources": [
                "github-actions"
            ],
            "versioning": "semver",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchPackageNames": [
                "symfony/*",
                "doctrine/*",
                "twig/*"
            ],
            "matchDatasources": [
                "packagist"
            ],
            "groupName": "Symfony Framework Related",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "description": "Automerge dev tooling updates (by Muse)",
            "matchManagers": [
                "composer"
            ],
            "matchPackagePatterns": [
                "^phpstan/",
                "^sentry/"
            ],
            "matchPackageNames": [
                "phpunit/phpunit"
            ],
            "groupName": "Dev tooling",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "ignoreTests": false
        }
    ],
    "bumpVersions": [
        {
            "name": "Application version",
            "filePatterns": [
                "config/services.php"
            ],
            "matchStrings": [
                "const APP_VERSION\\s*=\\s*['\"]v(?<version>\\d+\\.\\d+\\.\\d+)['\"]"
            ],
            "bumpType": "patch"
        }
    ],
    "assignees": [
        "mkaraki"
    ]
}
